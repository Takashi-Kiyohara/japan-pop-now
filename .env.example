# japan-pop-now.com — Environment Variables Template
# Copy to .env.local (or set in Vercel dashboard). NEVER commit .env.local.

# =============================================================================
# Affiliate programs (NEXT_PUBLIC_ = exposed to browser, required for client CTA)
# =============================================================================

# Klook — primary affiliate for activities/tickets
NEXT_PUBLIC_KLOOK_AFF_ID=

# Agoda — primary affiliate for hotels
NEXT_PUBLIC_AGODA_AFF_ID=

# Booking.com — backup hotel affiliate
NEXT_PUBLIC_BOOKING_AFF_ID=

# GetYourGuide — tours/experiences
NEXT_PUBLIC_GYG_AFF_ID=

# Viator — secondary experiences
NEXT_PUBLIC_VIATOR_AFF_ID=

# Amazon JP Associates — merch / goods (JP tag ends with -22)
NEXT_PUBLIC_AMAZON_TAG=

# =============================================================================
# Analytics & Ads
# =============================================================================

# GA4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# AdSense publisher ID (pub-XXXXXXXXXXXXXXXX) — currently pending approval
NEXT_PUBLIC_ADSENSE_PUB_ID=

# =============================================================================
# Server-side only (do NOT prefix with NEXT_PUBLIC_)
# =============================================================================

# Google Search Console (for gsc MCP server)
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=

# GA4 Data API (for ga4 MCP server)
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# GitHub PAT (for github MCP server) — fine-grained, read-only repo access
GITHUB_PAT=

# Vercel deploy hook (if used for manual triggers)
VERCEL_DEPLOY_HOOK=

# =============================================================================
# Optional: SNS auto-post (Threads + X) — used by Cowork Scheduled Tasks
# =============================================================================

THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
