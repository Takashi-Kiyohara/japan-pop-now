#!/usr/bin/env bash
# .githooks/pre-commit
# Secret scan + hardcoded affiliate ID scan on staged content.
# Enable with: git config core.hooksPath .githooks
set -eu

STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
[ -z "$STAGED" ] && exit 0

FAIL=0

for file in $STAGED; do
  # Skip binaries / large / known safe
  case "$file" in
    *.png|*.jpg|*.jpeg|*.webp|*.gif|*.mp4|*.mov|*.pdf|*.zip|*.woff*|*.ttf|*.otf|*.svg) continue ;;
    package-lock.json|pnpm-lock.yaml|yarn.lock) continue ;;
    .githooks/*) continue ;;
  esac

  [ ! -f "$file" ] && continue

  # Skip files larger than 500KB
  size=$(wc -c < "$file" 2>/dev/null || echo 0)
  [ "$size" -gt 512000 ] && continue

  STAGED_CONTENT=$(git show ":$file" 2>/dev/null || cat "$file")

  check() {
    local pattern="$1"
    local label="$2"
    if echo "$STAGED_CONTENT" | grep -qE "$pattern"; then
      echo "[pre-commit FAIL] $label in $file" >&2
      FAIL=1
    fi
  }

  # --- Secrets -----------------------------------------------------------
  check 'gh[pousr]_[A-Za-z0-9_]{20,}' "GitHub token"
  check 'AKIA[0-9A-Z]{16}' "AWS access key"
  check 'AIza[0-9A-Za-z_\-]{35}' "Google API key"
  check '(sk|pk|rk)_live_[A-Za-z0-9]{20,}' "Stripe live key"
  check 'xox[baprs]-[0-9]+-[0-9]+-[A-Za-z0-9]+' "Slack token"
  check 'sk-ant-api[0-9]{2}-[A-Za-z0-9_\-]{80,}' "Anthropic key"
  check 'sk-proj-[A-Za-z0-9_\-]{80,}' "OpenAI project key"
  check 'BEGIN (RSA |OPENSSH |EC |DSA |PGP )?PRIVATE KEY' "Private key block"
  check '(mongodb|postgres|mysql|redis)://[^:]+:[^@]+@' "DB connection string with password"

  # --- Affiliate hardcoded IDs -------------------------------------------
  case "$file" in
    *.ts|*.tsx|*.js|*.jsx|*.md|*.mdx)
      if echo "$STAGED_CONTENT" | grep -qE 'klook\.com[^"\047 ]*[?&](aff|aid)=[0-9]+'; then
        if ! echo "$STAGED_CONTENT" | grep -qE 'process\.env\.[A-Z_]*KLOOK'; then
          echo "[pre-commit FAIL] Hardcoded Klook aff_id in $file (use env var)" >&2
          FAIL=1
        fi
      fi
      if echo "$STAGED_CONTENT" | grep -qE 'amazon\.co\.jp[^"\047 ]*[?&]tag=[a-z0-9-]+-22'; then
        if ! echo "$STAGED_CONTENT" | grep -qE 'process\.env\.[A-Z_]*AMAZON'; then
          echo "[pre-commit FAIL] Hardcoded Amazon tag in $file (use env var)" >&2
          FAIL=1
        fi
      fi
      ;;
  esac

  # --- Takapon pseudonym -------------------------------------------------
  case "$file" in
    content/articles/*|public/*|components/*|app/*)
      if echo "$STAGED_CONTENT" | grep -q '清原崇'; then
        echo "[pre-commit FAIL] Real name detected in $file — use 'Takapon'" >&2
        FAIL=1
      fi
      ;;
  esac
done

# --- .env files staged? (allow .env.example template) -------------------
ENV_STAGED=$(echo "$STAGED" | grep -E '^\.env(\.|$)' | grep -v '^\.env\.example$' || true)
if [ -n "$ENV_STAGED" ]; then
  echo "[pre-commit FAIL] .env file is staged: $ENV_STAGED" >&2
  echo "Run: git restore --staged .env*" >&2
  FAIL=1
fi

if [ $FAIL -ne 0 ]; then
  cat >&2 <<'EOF'

Commit blocked. Resolve the failures above, then re-commit.
To bypass in an emergency: git commit --no-verify (DON'T do this for secrets)

EOF
  exit 1
fi

exit 0
